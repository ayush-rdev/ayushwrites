---
import { BASE, SITE } from '../consts';

const base = BASE;
const path = Astro.url.pathname;

const links = [
  { href: base, label: 'writings' },
  { href: `${base}about`, label: 'about' },
  { href: `${base}now`, label: 'now' },
];
---
<header class="site-head" transition:persist>
  <div class="site-head__inner">
    <a href={base} class="wordmark" aria-label="home">
      <span class="doodle" aria-hidden="true">✳</span>
      {SITE.title}
    </a>

    <div class="site-head__right">
      <nav class="nav" aria-label="main">
        {
          links.map(({ href, label }) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
      </nav>

      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="switch between light and dark theme"
        aria-pressed="false"
      >
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">☀</span>
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">☾</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.documentElement;

    function currentTheme() {
      return root.dataset.theme === 'dark' ? 'dark' : 'light';
    }

    function syncMeta(theme) {
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) {
        m.setAttribute('content', theme === 'dark' ? '#16130f' : '#faf3e4');
      }
    }

    // the header persists across page transitions, so the highlighted nav
    // item has to catch up with the URL after every navigation
    function syncActiveLink() {
      var path = location.pathname;
      var links = document.querySelectorAll('.nav a');
      for (var i = 0; i < links.length; i++) {
        var href = links[i].getAttribute('href') || '';
        if (href === path) {
          links[i].setAttribute('aria-current', 'page');
        } else {
          links[i].removeAttribute('aria-current');
        }
      }
    }

    function initToggle() {
      syncActiveLink();
      var btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.initialized) return;
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', function () {
        var next = currentTheme() === 'dark' ? 'light' : 'dark';

        // the circular reveal starts from the button's position
        var rect = btn.getBoundingClientRect();
        root.style.setProperty('--click-x', Math.round(rect.left + rect.width / 2) + 'px');
        root.style.setProperty('--click-y', Math.round(rect.top + rect.height / 2) + 'px');

        try {
          localStorage.setItem('theme', next);
        } catch (e) {}

        function apply() {
          root.dataset.theme = next;
          btn.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
          syncMeta(next);
        }

        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (document.startViewTransition && !reduced) {
          root.classList.add('theme-switching');
          try {
            var vt = document.startViewTransition(apply);
            if (vt && vt.finished) {
              vt.finished.finally(function () {
                root.classList.remove('theme-switching');
              });
            } else {
              root.classList.remove('theme-switching');
            }
          } catch (e) {
            // a transition is already in progress — just swap directly
            root.classList.remove('theme-switching');
            apply();
          }
        } else {
          apply();
        }
      });

      btn.setAttribute('aria-pressed', currentTheme() === 'dark' ? 'true' : 'false');
    }

    initToggle();
    // the header persists, but this script re-runs on every navigation —
    // the flag below keeps us from stacking duplicate listeners
    if (!window.__themeToggleBound) {
      window.__themeToggleBound = true;
      document.addEventListener('astro:after-swap', initToggle);
    }

    // hide the sticky header while scrolling down; glide it back on scroll up
    if (!window.__headScrollBound) {
      window.__headScrollBound = true;
      // keep the nav pinned in place for folks who prefer reduced motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var head = document.querySelector('.site-head');
      if (head) {
        var lastY = window.scrollY;
        var ticking = false;

        function update() {
          ticking = false;
          var y = window.scrollY;
          if (y <= 10) {
            // at (or near) the top — always keep the header visible
            head.classList.remove('site-head--hidden');
          } else if (y > lastY + 10) {
            head.classList.add('site-head--hidden');
          } else if (y < lastY - 10) {
            head.classList.remove('site-head--hidden');
          }
          lastY = y;
        }

        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });

        // after a page transition the new page starts at a fresh scroll
        // position — reset the direction tracker and reveal the header
        window.addEventListener('astro:page-load', function () {
          lastY = window.scrollY;
          head.classList.remove('site-head--hidden');
        });
      }
    }
  })();
</script>
