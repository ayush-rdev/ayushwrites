---
import BaseLayout from '../layouts/BaseLayout.astro';
import Squiggle from '../components/Squiggle.astro';
import { getCollection, render } from 'astro:content';

// the page content lives in src/content/now/now.md — editable from /admin
const [nowEntry] = await getCollection('now');
const { Content } = await render(nowEntry);
const updated = nowEntry.data.updated;
---
<BaseLayout title="now">
  <article class="post">
    <header class="post__header">
      <h1>now</h1>
      {updated && <p class="post__meta">last updated: {updated}</p>}
    </header>

    <Squiggle />

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
