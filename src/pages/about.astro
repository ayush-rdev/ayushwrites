---
import BaseLayout from '../layouts/BaseLayout.astro';
import Squiggle from '../components/Squiggle.astro';
import { BASE } from '../consts';
---
<BaseLayout title="about">
  <article class="post">
    <header class="post__header">
      <h1>about me</h1>
      <p class="post__meta">a very short introduction</p>
    </header>

    <Squiggle />

    <div class="prose">
      <p>
        I am Ayush, a computer science enthusiast, into cloud security web development and reverse engineering.
      </p>
      <p>
        That's it I guess, btw I'm also into Metaphysics, Philosophy, Psychological, Robotics and Physics.
      </p>
      <blockquote>“a blog is a conversation you have with the future you.”</blockquote>
    </div>

    <div class="sticker" style="margin-top: 1.2rem;">
      also see: <a href={`${BASE}now`}>what i'm doing now →</a>
    </div>

    <section style="margin-top: 1.9rem;">
      <div class="section-title">
        <span class="hand" aria-hidden="true">✎</span>
        <h2>colophon</h2>
      </div>
      <div class="box">
        <p>
          This site is built by hand with
          <a href="https://astro.build">Astro</a>, set in Georgia &amp; Caveat,
          and hosted wherever you decide. No trackers, no cookies.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
