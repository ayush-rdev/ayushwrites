---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE } from '../consts';

const base = BASE;
---
<BaseLayout title="not found">
  <section class="notfound">
    <h1 class="big">404</h1>
    <p>this page wandered off into the woods and didn't come back.</p>
    <p style="margin-top: 1.6rem;">
      <a href={base}>→ back to the corner</a>
    </p>
  </section>
</BaseLayout>
