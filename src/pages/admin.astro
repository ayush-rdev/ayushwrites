---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BASE, SITE } from '../consts';
import '../styles/admin.css';

const base = BASE;
const defaultOwner = SITE.url ? new URL(SITE.url).hostname.split('.')[0] : '';
---
<BaseLayout title="admin">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <!-- lock screen -->
  <section id="a-lock" class="a-lock-wrap" hidden>
    <div class="a-lock">
      <div class="a-lock__card">
        <div class="a-lock__brand">
          <span class="dot">✳</span> {SITE.title}
          <span class="tag">admin</span>
        </div>
        <p class="a-lock__sub">Sign in to manage your blog.</p>

        <label class="a-label">
          GitHub personal access token
          <input id="a-token" class="a-input a-mono" type="password" autocomplete="off" spellcheck="false" placeholder="ghp_… or github_pat_…" />
        </label>

        <div class="a-lock__row">
          <label class="a-label">
            owner
            <input id="a-owner" class="a-input a-mono" value={defaultOwner} spellcheck="false" />
          </label>
          <label class="a-label">
            repo
            <input id="a-repo" class="a-input a-mono" value={BASE.replace(/\//g, '')} spellcheck="false" />
          </label>
        </div>

        <div class="a-btn-row" style="margin-top: .9rem;">
          <button id="a-connect" class="a-btn a-btn--primary" type="button">connect</button>
        </div>

        <p class="a-lock__hint">
          The token only lives in your browser (localStorage) and talks to the GitHub
          API directly — every save is a commit and the deploy workflow runs it.
          <br />
          <strong>Prefer a fine-grained token</strong> scoped to just this repo with
          Contents: read &amp; write. A classic token with broad scopes will be flagged
          by the admin.
          <br />
          <a class="a-out" href="https://github.com/settings/tokens" target="_blank" rel="noopener">manage tokens →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- app shell -->
  <div id="a-shell" class="a-shell" hidden>
    <aside class="a-side">
      <div class="a-side__brand">
        <span class="dot">✳</span> {SITE.title}
        <span class="tag">admin</span>
      </div>

      <p class="a-side__section">content</p>
      <nav class="a-side__nav">
        <a class="a-nav" data-view="dashboard" href="#/dashboard"><span class="ico">⌂</span> dashboard</a>
        <a class="a-nav" data-view="posts" href="#/posts"><span class="ico">✍</span> posts</a>
        <a class="a-nav" data-view="media" href="#/media"><span class="ico">🖼</span> media</a>
        <a class="a-nav" data-view="tags" href="#/tags"><span class="ico">#</span> tags</a>
      </nav>

      <p class="a-side__section">site</p>
      <nav class="a-side__nav">
        <a class="a-nav" data-view="files" href="#/files"><span class="ico">📄</span> pages &amp; files</a>
        <a class="a-nav" data-view="settings" href="#/settings"><span class="ico">⚙</span> settings</a>
        <a class="a-nav" data-view="now" href="#/now"><span class="ico">✳</span> now page</a>
      </nav>

      <p class="a-side__section">system</p>
      <nav class="a-side__nav">
        <a class="a-nav" data-view="tools" href="#/tools"><span class="ico">🧰</span> import &amp; export</a>
        <a class="a-nav" data-view="deploy" href="#/deploy"><span class="ico">🚀</span> deploy</a>
      </nav>

      <div class="a-side__foot">
        <span class="a-side__repo" id="a-repo-line"></span>
        <div class="a-btn-row">
          <button id="a-theme" class="a-mini" type="button" title="toggle theme">🌙</button>
          <a class="a-mini" href={base} target="_blank" rel="noopener" title="view site">↗ site</a>
          <button id="a-lock-btn" class="a-mini" type="button" title="forget the token and lock">lock</button>
        </div>
      </div>
    </aside>

    <main class="a-main">
      <div id="a-view"></div>
    </main>
  </div>

  <div id="a-toasts" class="a-toasts" aria-live="polite"></div>
</BaseLayout>

<style>
  /* the lock screen is its own centered panel, outside the grid shell */
  .a-lock-wrap {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 6vh 1.2rem 3rem;
    background: var(--a-bg);
  }

  .a-lock-wrap[hidden] {
    display: none;
  }

  .a-lock {
    width: min(26rem, 100%);
  }

  .a-lock__card {
    background: var(--a-surface);
    border: 1px solid var(--a-border);
    border-radius: 14px;
    box-shadow: var(--a-shadow);
    padding: 1.5rem 1.6rem 1.3rem;
  }

  .a-lock__brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .a-lock__brand .dot {
    color: var(--a-accent);
  }

  .a-lock__brand .tag {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--a-muted);
  }

  .a-lock__sub {
    margin: 0 0 1.1rem;
    color: var(--a-muted);
    font-size: 0.88rem;
  }

  .a-lock__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
    margin-top: 0.7rem;
  }

  .a-lock__hint {
    margin: 1.1rem 0 0;
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--a-muted);
  }
</style>

<script>
  import { mount } from '../scripts/admin/app.js';
  mount();
</script>
