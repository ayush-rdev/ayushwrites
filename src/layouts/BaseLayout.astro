---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { BASE, SITE } from '../consts';
// self-hosted handwritten font — no third-party requests, no render-blocking
// external stylesheet (bundled + hashed by Astro, latin-only subsets since
// the site is English-only)
import '@fontsource/caveat/latin-400.css';
import '@fontsource/caveat/latin-500.css';
import '@fontsource/caveat/latin-700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
} = Astro.props;

const base = BASE;
const pageTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;

// a soft crossfade with a gentle upward drift — unhurried enough to feel
// smooth, fast enough to stay out of the way (the easing curve decelerates
// like a sheet of paper settling into place)
const pageAnim = {
  forwards: {
    old: { name: 'vt-fade-out', duration: '0.15s', easing: 'ease-in', fillMode: 'both' },
    new: {
      name: 'vt-fade-up-in',
      duration: '0.4s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: { name: 'vt-fade-out', duration: '0.15s', easing: 'ease-in', fillMode: 'both' },
    new: {
      name: 'vt-fade-up-in',
      duration: '0.4s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf3e4" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={`${base}rss.xml`} />

    <!-- client-side page transitions -->
    <ClientRouter />

    <!-- open graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${SITE.url}${base}`} />

    <title>{pageTitle}</title>

    <!-- extra head content, e.g. robots meta for the admin page -->
    <slot name="head" />

    <!-- set the theme before first paint, so there's no flash of the wrong one -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        // white is the default; dark only if the visitor explicitly chose it
        var theme = stored === 'dark' ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', theme === 'dark' ? '#16130f' : '#faf3e4');
        }

        // Astro's router rebuilds <html> attributes on navigation, so hand the
        // current theme to the incoming document before it gets swapped in
        document.addEventListener('astro:before-swap', function (event) {
          var current = document.documentElement.dataset.theme || 'light';
          var newDoc = event.newDocument;
          if (!newDoc) return;
          newDoc.documentElement.setAttribute('data-theme', current);
          var m = newDoc.querySelector('meta[name="theme-color"]');
          if (m) {
            m.setAttribute('content', current === 'dark' ? '#16130f' : '#faf3e4');
          }
        });
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">skip to content</a>
    <Header />
    <main
      class="page"
      id="main"
      transition:animate={pageAnim}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
